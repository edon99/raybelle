{% comment %}
  Frequently asked questions.

  Built on native <details>/<summary>, which gives keyboard operation, screen
  reader semantics and find-in-page expansion for free. A scripted accordion
  would have to re-implement all three.
{% endcomment %}

<div id="faq" class="faq band {{ section.settings.band }} band-pad full-width">
  <div class="faq__inner">
    <header class="faq__head reveal">
      {% if section.settings.kicker != blank %}
        <p class="eyebrow">{{ section.settings.kicker }}</p>
      {% endif %}
      <h2 class="display section-title faq__title">{{ section.settings.heading }}</h2>
    </header>

    <div class="faq__list">
      {% for block in section.blocks %}
        <details
          class="faq__item"
          name="faq-{{ section.id }}"
          {{ block.shopify_attributes }}
          {% if forloop.first and section.settings.open_first %}
            open
          {% endif %}
        >
          <summary class="faq__q">
            <span>{{ block.settings.question }}</span>
            <span class="faq__marker" aria-hidden="true"></span>
          </summary>
          <div class="faq__a measure">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .faq__inner {
    display: grid;
    grid-template-columns: var(--content-grid);
    row-gap: var(--space-12);
  }

  .faq__head,
  .faq__list {
    grid-column: 2;
  }

  .faq__title {
    margin-block-start: var(--space-3);
  }

  .faq__list {
    display: grid;
    max-width: 68ch;
  }

  /* Rules between rows read quieter than a box around each one. */
  .faq__item {
    border-block-end: 1px solid var(--color-hairline);
    padding-block: var(--space-4);
  }

  .faq__item:first-of-type {
    border-block-start: 1px solid var(--color-hairline);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 44px;
    font-family: var(--font-heading--family);
    font-size: var(--text-lg);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  /* Hide the default disclosure triangle in WebKit. */
  .faq__q::-webkit-details-marker {
    display: none;
  }

  /* Plus sign that becomes a minus when open, drawn with pseudo elements. */
  .faq__marker {
    position: relative;
    flex: none;
    width: 20px;
    height: 20px;
  }

  .faq__marker::before,
  .faq__marker::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    width: 100%;
    height: 2px;
    background-color: currentcolor;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .faq__marker::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__marker::after {
    transform: rotate(0deg);
  }

  .faq__a {
    padding-block-start: var(--space-3);
    opacity: 0.9;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.faq",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "band",
      "label": "t:labels.band",
      "default": "band--page",
      "options": [
        { "value": "band--page", "label": "t:options.band.page" },
        { "value": "band--surface", "label": "t:options.band.surface" },
        { "value": "band--brand-1", "label": "t:options.band.brand_1" },
        { "value": "band--brand-2", "label": "t:options.band.brand_2" },
        { "value": "band--brand-3", "label": "t:options.band.brand_3" },
        { "value": "band--ink", "label": "t:options.band.ink" }
      ]
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:labels.kicker",
      "default": "Questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Before you buy"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "t:labels.open_first",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:general.question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:labels.question",
          "default": "A question people actually ask"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:labels.answer",
          "default": "<p>A short, direct answer.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.faq",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "question": "Does it need an outlet?",
            "answer": "<p>No. It charges over USB-C and holds roughly 20 shots, so a weekend away needs no plug at all.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Ground coffee or pods?",
            "answer": "<p>Both. The basket takes about 8 g of ground coffee, and a pod adapter is in the box.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Can I take it on a plane?",
            "answer": "<p>Yes. There is no pressurised canister and the battery is under the 100 Wh cabin limit.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "How do I clean it?",
            "answer": "<p>Add water, run one pulse, tip it out. Roughly every month, run a descaling cycle with the tablet provided.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
