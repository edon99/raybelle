{% comment %}
  Numbered "how it works" sequence.

  Step numbers come from the loop index rather than a per-block setting, so
  reordering blocks in the theme editor renumbers them automatically and they
  can never drift out of sequence.
{% endcomment %}

<div id="how-it-works" class="steps band {{ section.settings.band }} band-pad full-width">
  <div class="steps__inner">
    <header class="steps__head reveal">
      {% if section.settings.kicker != blank %}
        <p class="eyebrow">{{ section.settings.kicker }}</p>
      {% endif %}
      <h2 class="display section-title steps__title">{{ section.settings.heading }}</h2>
    </header>

    <ol class="steps__list">
      {% for block in section.blocks %}
        <li class="steps__item reveal" {{ block.shopify_attributes }}>
          <div class="steps__body">
            <span class="steps__num display" aria-hidden="true">{{ forloop.index }}</span>
            <div class="steps__content">
              <h3 class="steps__item-title">{{ block.settings.heading }}</h3>
              {% if block.settings.text != blank %}
                <p class="steps__item-text">{{ block.settings.text }}</p>
              {% endif %}
            </div>
          </div>
          {% if block.settings.image != blank or block.settings.demo_asset != blank %}
            <div class="steps__frame">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag: class: 'steps__img', widths: '300,500,800', sizes: '(min-width: 900px) 30vw, 90vw', loading: 'lazy'
                }}
              {% else %}
                {% comment %} Bundled demo photography — see assets/DEMO-IMAGES.txt {% endcomment %}
                <img
                  class="steps__img"
                  src="{{ block.settings.demo_asset | asset_url }}"
                  alt=""
                  width="800"
                  height="640"
                  loading="lazy"
                >
              {% endif %}
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  </div>
</div>

{% stylesheet %}
  .steps__inner {
    display: grid;
    grid-template-columns: var(--content-grid);
    row-gap: var(--space-12);
  }

  .steps__head,
  .steps__list {
    grid-column: 2;
  }

  .steps__title {
    margin-block-start: var(--space-3);
  }

  .steps__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  /* The image leads; the numeral and copy sit beneath it. */
  .steps__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .steps__body {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
  }

  /*
   * The numeral is the ornament. Set large in the display face and dropped to
   * a tint, it marks the sequence without a filled disc fighting the type.
   */
  .steps__num {
    flex: none;
    font-size: var(--text-2xl);
    line-height: 1;
    opacity: 0.4;
    font-variant-numeric: lining-nums;
  }

  .steps__item-title {
    font-size: var(--text-lg);
    margin-block-end: var(--space-2);
  }

  .steps__item-text {
    opacity: 0.85;
  }

  .steps__frame {
    overflow: hidden;
    border-radius: var(--radius-block);
    aspect-ratio: 5 / 4;
    order: -1;
  }

  .steps__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.steps",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "band",
      "label": "t:labels.band",
      "default": "band--brand-2",
      "options": [
        { "value": "band--page", "label": "t:options.band.page" },
        { "value": "band--surface", "label": "t:options.band.surface" },
        { "value": "band--brand-1", "label": "t:options.band.brand_1" },
        { "value": "band--brand-2", "label": "t:options.band.brand_2" },
        { "value": "band--brand-3", "label": "t:options.band.brand_3" },
        { "value": "band--ink", "label": "t:options.band.ink" }
      ]
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:labels.kicker",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Three moves to a real shot"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:general.step",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Step"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text",
          "default": "What happens at this step."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "demo_asset",
          "label": "t:labels.demo_asset",
          "info": "t:info.demo_asset"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.steps",
      "blocks": [
        {
          "type": "step",
          "settings": { "heading": "Fill", "text": "Water in the base, coffee in the basket." }
        },
        {
          "type": "step",
          "settings": { "heading": "Press", "text": "One button. It heats and pulls the shot itself." }
        },
        {
          "type": "step",
          "settings": { "heading": "Rinse", "text": "Water, one pulse, tip it out. Ten seconds." }
        }
      ]
    }
  ]
}
{% endschema %}
